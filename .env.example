# Credenciales locales de PostgreSQL usadas por docker-compose.yml.
# Copia este archivo como .env y cambia los valores. El archivo .env real NO se versiona.
POSTGRES_USER=flowtrim
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=flowtrim
# Puerto del host. Usa otro (p. ej. 5433) si ya tienes un PostgreSQL local ocupando el 5432.
POSTGRES_PORT=5432
